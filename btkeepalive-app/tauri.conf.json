{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BT KeepAlive",
  "version": "2.0.0",
  "identifier": "com.btkeepalive.app",
  "build": {
    "frontendDist": "./settings-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BT KeepAlive Settings",
        "width": 560,
        "height": 760,
        "minWidth": 480,
        "minHeight": 600,
        "visible": false,
        "decorations": true,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "wix": null,
      "nsis": null
    }
  }
}
